{
  "name": "victormgomes/auto-translate",
  "description": "Automatic translation for translatable attributes in Eloquent models",
  "version": "0.0.4",
  "keywords": [
    "Victor M. Gomes",
    "laravel",
    "auto-translate"
  ],
  "homepage": "https://github.com/victormgomes/auto-translate",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/victormgomes/auto-translate/issues",
    "source": "https://github.com/victormgomes/auto-translate"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/VictorMGomes"
    }
  ],
  "authors": [
    {
      "name": "Victor M. Gomes",
      "email": "info@victormgomes.net",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "spatie/laravel-package-tools": "^1.16",
    "laravel/ai": "^1.0",
    "illuminate/contracts": "^11.0||^12.0||^13.0",
    "illuminate/support": "^11.0||^12.0||^13.0",
    "illuminate/database": "^11.0||^12.0||^13.0",
    "illuminate/http": "^11.0||^12.0||^13.0",
    "illuminate/bus": "^11.0||^12.0||^13.0",
    "illuminate/queue": "^11.0||^12.0||^13.0",
    "illuminate/cache": "^11.0||^12.0||^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.14",
    "nunomaduro/collision": "^8.8",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0.0||^9.0.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "spatie/laravel-ray": "^1.35"
  },
  "autoload": {
    "psr-4": {
      "Victormgomes\\AutoTranslate\\": "src/",
      "Victormgomes\\AutoTranslate\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Victormgomes\\AutoTranslate\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Victormgomes\\AutoTranslate\\AutoTranslateServiceProvider"
      ],
      "aliases": {
        "AutoTranslate": "Victormgomes\\AutoTranslate\\Facades\\AutoTranslate"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
